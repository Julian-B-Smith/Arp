{
  "format": "arp-params/1",
  "status": "DRAFT r2.12 2026-10-22 (Phase A); protected once the human ratifies spec/",
  "tpq": 15360,
  "note": "Every setting is a morph target (D-000 Open 5). All values are INTEGERS in the snapshot (horde rounds morph blends). kind=continuous blends; kind=discrete resolves to the largest-weight corner with 0.05 hysteresis and applies from the next evaluated step (SPEC §9, Q-A1 PROPOSED); `enabled` applies at offset 0 of its block (SPEC T4/T5). Enums are stored by NAME. Tempo is clamped to [20, 999] bpm (SPEC §1.3).",
  "params": [
    {
      "key": "enabled",
      "kind": "discrete",
      "type": "bool",
      "default": false,
      "ref": "SPEC §7 T4/T5, §9",
      "note": "the WHOLE module (off: horde routes input around Arp; every chord and arp note ends, T4)"
    },
    {
      "key": "arp_enabled",
      "kind": "discrete",
      "type": "bool",
      "default": true,
      "ref": "SPEC §14",
      "note": "the arp alone; off with chord_enabled on = a chord generator; toggling never touches chord notes; applies at offset 0 (D-019)"
    },
    {
      "key": "order",
      "kind": "discrete",
      "type": "enum",
      "values": [
        "up",
        "down",
        "bounce",
        "bounce2",
        "played",
        "chord",
        "random",
        "shuffle",
        "converge",
        "diverge",
        "pedal_low",
        "pedal_high",
        "chord_walk",
        "stride",
        "chord_between",
        "pairs"
      ],
      "default": "up",
      "ref": "SPEC §4.2"
    },
    {
      "key": "pattern",
      "kind": "discrete",
      "type": "enum",
      "values_from": "spec/bank/starter.json patterns[].id, plus `user` (the player's own pattern, SPEC §4.6)",
      "default": "none",
      "ref": "SPEC §4.3"
    },
    {
      "key": "rate",
      "kind": "discrete",
      "type": "enum",
      "values_from": "rate[].name (aliases accepted on load)",
      "default": "1/16",
      "ref": "SPEC §2.1",
      "note": "used in rate_mode = sync"
    },
    {
      "key": "rate_mode",
      "kind": "discrete",
      "type": "enum",
      "values": [
        "sync",
        "time"
      ],
      "default": "sync",
      "ref": "SPEC §2.6",
      "note": "sync = tempo-synced divisions (rate); time = a free step length (step_time_us) from the key press, ignoring the host tempo and transport (D-016)"
    },
    {
      "key": "step_time_us",
      "kind": "continuous",
      "type": "int",
      "min": 10000,
      "max": 2000000,
      "default": 125000,
      "ref": "SPEC §2.6",
      "unit": "microseconds per step",
      "display": "both ms per step and Hz (= 1e6 / step_time_us), shown together",
      "note": "used in rate_mode = time"
    },
    {
      "key": "steps",
      "kind": "discrete",
      "type": "int",
      "min": 0,
      "max": 8,
      "default": 0,
      "ref": "SPEC §4.7",
      "note": "transposition steps, Ableton-style: the whole pattern repeats shifted by step_size each pass, `steps` times, then returns; 0 = none (D-014)"
    },
    {
      "key": "step_size",
      "kind": "discrete",
      "type": "int",
      "min": -48,
      "max": 48,
      "default": 12,
      "ref": "SPEC §4.7",
      "note": "shift per pass, in step_unit"
    },
    {
      "key": "step_unit",
      "kind": "discrete",
      "type": "enum",
      "values": [
        "semitones",
        "degrees"
      ],
      "default": "semitones",
      "ref": "SPEC §4.7",
      "note": "degrees = in-scale keys of the effective scale (§6); with no scale active, a degree is a semitone"
    },
    {
      "key": "gate",
      "kind": "continuous",
      "type": "percent",
      "min": 1,
      "max": 200,
      "default": 80,
      "ref": "SPEC §5"
    },
    {
      "key": "swing",
      "kind": "continuous",
      "type": "permille",
      "min": 500,
      "max": 750,
      "default": 500,
      "ref": "SPEC §5",
      "note": "500 straight, 667 triplet feel"
    },
    {
      "key": "latch",
      "kind": "discrete",
      "type": "enum",
      "values": [
        "off",
        "replace",
        "append"
      ],
      "default": "off",
      "ref": "SPEC §3"
    },
    {
      "key": "vel_mode",
      "kind": "discrete",
      "type": "enum",
      "values": [
        "played",
        "fixed"
      ],
      "default": "played",
      "ref": "SPEC §4.4"
    },
    {
      "key": "vel_fixed",
      "kind": "continuous",
      "type": "int",
      "min": 1,
      "max": 127,
      "default": 100,
      "ref": "SPEC §4.4"
    },
    {
      "key": "restart",
      "kind": "discrete",
      "type": "enum",
      "values": [
        "chord",
        "bar",
        "free"
      ],
      "default": "chord",
      "ref": "SPEC §4.5"
    },
    {
      "key": "repeats",
      "kind": "discrete",
      "type": "int",
      "min": 0,
      "max": 16,
      "default": 0,
      "ref": "SPEC §4.8",
      "note": "full cycles of the whole pattern per chord, then stop until the next gesture; 0 = forever (D-018)"
    },
    {
      "key": "quantize",
      "kind": "discrete",
      "type": "enum",
      "values": [
        "off",
        "scale",
        "chord_root"
      ],
      "default": "off",
      "ref": "SPEC §6",
      "note": "off; scale = snap to the scale anchored at its root; chord_root = horde's movable-do 'scale (offset)' mode for an arp: the scale SHAPE anchored on the lowest held key (the root setting is ignored, as in horde ADR-112) — governs the arp AND the chord stage: while on, every note Arp emits is in the effective scale, the played note included (D-020)"
    },
    {
      "key": "scale_source",
      "kind": "discrete",
      "type": "enum",
      "values": [
        "global",
        "own"
      ],
      "default": "global",
      "ref": "SPEC §6",
      "note": "global = horde's scale (scaleRoot + scaleDeg0..11, B260), read never owned; own = Arp's scale_root + scale_deg0..11 below, in exactly horde's shape (D-010)"
    },
    {
      "key": "scale_root",
      "kind": "discrete",
      "type": "int",
      "min": 0,
      "max": 11,
      "default": 0,
      "ref": "SPEC §6",
      "note": "C=0 … B=11; horde's scaleRoot shape"
    },
    {
      "key": "scale_deg0",
      "kind": "discrete",
      "type": "bool",
      "default": true,
      "ref": "SPEC §6",
      "note": "degree 0: the pitch class 0 semitones above scale_root is in the scale (horde's scaleDeg0; root-relative)"
    },
    {
