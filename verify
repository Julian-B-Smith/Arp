#!/usr/bin/env bash
# verify — oracle dispatcher. The harness's only interface to project QC.
# Usage: ./verify fast | full | report
# Contract: exit 0 = green, nonzero = red. Writes .harness/last-verify.json.
#
# (This is the template a new or retrofitted project copies as its ./verify.
# It carries NO gate code: until 2.4.0 it shipped an inline `leak_gate`, and
# every repo born from it got a private copy that then drifted — ten variants,
# nine missing the Windows pattern. The gate now lives in kit/vendor/kit-gates.sh,
# which is canonical, vendored into .kit/, and pinned by sha256.)
#
# THIS FILE IS PROJECT-OWNED: edit `fast` and `full` freely, add project gates,
# wire your test commands. The kit-owned gates live in `.kit/kit-gates.sh`,
# which is vendored and checksummed — do not edit that one, and do not copy its
# contents here. Update it with:  python3 <kit>/kit_sync.py .
set -uo pipefail

TARGET="${1:-fast}"
HARNESS_DIR=".harness"
mkdir -p "$HARNESS_DIR"

# Kit-owned gates: record, leak_gate, kit_integrity. A repo missing this file
# is not a lesser repo, it is an UNGATED one, so failing loudly beats degrading
# quietly — a silently skipped privacy gate is exactly the shape of bug the
# gate exists to prevent.
if [ -r .kit/kit-gates.sh ]; then
  . .kit/kit-gates.sh
else
  echo "verify: .kit/kit-gates.sh missing — run kit_sync.py (gates cannot be skipped)" >&2
  exit 1
fi

# ---- Project-owned gates ----------------------------------------------------

# Private-sibling alias rule (HYPERSAW ADR-014, inherited via Scape/Bulwark/Echo):
# a private sibling's real name never enters a tracked file. This repo is PUBLIC.
# Names come from the UNTRACKED .leakcheck-names (absent on CI, where the check
# skips loudly, never silently).
private_name_gate() {
  if [ ! -f .leakcheck-names ]; then
    echo "verify: .leakcheck-names absent — private-name leak check SKIPPED (expected off the dev Mac)" >&2
    return 0
  fi
  local pat hits
  pat=$(grep -vE '^[[:space:]]*(#|$)' .leakcheck-names | paste -sd'|' -)
  [ -n "$pat" ] || return 0
  # Case-SENSITIVE by design (a case-insensitive draft in Scape tripped on prose).
  # `--untracked` is load-bearing: git grep skips new, unstaged files otherwise.
  hits=$(git grep --untracked -nIP "($pat)" -- . \
           ':(exclude)PRIVATE-NOTES.md' ':(exclude).leakcheck-names' 2>/dev/null || true)
  [ -n "$hits" ] || return 0
  echo "verify: LEAK — a private sibling's real name in a tracked file (alias it; map in PRIVATE-NOTES.md):" >&2
  echo "$hits" | sed 's/^/    /' >&2
  return 1
}

# Structure: the kit baseline every session assumes is present, plus the intake
# packet the spec is written against. Grows as spec/, lab/ and core/ land.
structure_gate() {
  local ok=0 f
  for f in CLAUDE.md ROADMAP.md DECISIONS.md README.md CODEMAP.md INDEX.md LIBRARY.md \
           SPINUP-BRIEF.md project.manifest.json integrations/README.md traces/README.md \
           intake/MANIFEST intake/note-vocabulary.md intake/engine-note-interface.md \
           intake/quantizer.md intake/tempo-divisions.md \
           docs/prior-art.md spec/SPEC.md spec/params.json spec/bank/starter.json spec/MANIFEST \
           lab/arp-lab.html tools/lab_smoke.mjs \
           core/CMakeLists.txt core/include/arp/core.h core/src/core.cpp tools/core_test.sh tools/core_params_check.py \
           core/include/arp/pattern.h core/include/arp/bank_data.h tools/gen_bank.py tests/core/test_m1b.cpp \
           .gitattributes .github/workflows/ci.yml; do
    [ -e "$f" ] || { echo "verify: structure — missing $f" >&2; ok=1; }
  done
  return $ok
}

# Manifest: valid JSON, the survey fields the kit expects, no status prose drift
# (Decision 28: status is a date + "see ROADMAP", never a paragraph).
manifest_gate() {
  python3 - <<'PYG' || return 1
import json, sys
m = json.load(open("project.manifest.json"))
req = ["what_is_it","architecture_rung","domain_core_llm_must_not_own","oracle_shape",
       "second_implementation","consumers_and_providers","parallel_audit_thread",
       "knowledge_loop_tags","lifespan_autonomy"]
missing = [k for k in req if k not in m.get("survey", {})]
if missing: print("verify: manifest — survey missing", missing, file=sys.stderr); sys.exit(1)
if m["survey"]["architecture_rung"]["choice"] not in (1,2,3):
    print("verify: manifest — rung must be 1|2|3", file=sys.stderr); sys.exit(1)
if not 3 <= len(m["survey"]["knowledge_loop_tags"]) <= 6:
    print("verify: manifest — 3..6 knowledge-loop tags", file=sys.stderr); sys.exit(1)
if len(m.get("status","")) > 300:
    print("verify: manifest — status is prose (>300 chars); phase state lives in ROADMAP", file=sys.stderr); sys.exit(1)
PYG
}

# Intake pin: intake/ is horde's handed-over record, read-only here (§Domain).
# Every file's sha256 must equal its intake/MANIFEST line, and every file must be
# listed, so a hand edit or a silently added file goes red. Asserts the EFFECTIVE
# bytes, not a "do not edit" note (kit README, gate rule). A re-pin is a human gate.
# NOTE: horde wrote this MANIFEST with REPO-ROOT paths (`intake/x.md`), unlike
# Echo's intake-relative ones — this gate is not a drop-in copy of Echo's.
# Shared by every hash-pinned directory: $1 = the directory, $2 = why it is pinned
# (printed on failure). <dir>/MANIFEST holds "sha256  <repo-root path>" lines.
pinned_dir_gate() {
  local d=$1 why=$2 m=$1/MANIFEST ok=0 h f got n=0
  [ -f "$m" ] || { echo "verify: $d — $m missing" >&2; return 1; }
  while read -r h f; do
    case "$h" in ''|'#'*) continue ;; esac
    n=$((n + 1))
    got=$(shasum -a 256 "$f" 2>/dev/null | cut -c1-64)
    [ "$got" = "$h" ] || { echo "verify: $d — $f does not match its MANIFEST hash ($why)" >&2; ok=1; }
  done < "$m"
  [ "$n" -gt 0 ] || { echo "verify: $d — no hashed files in $m" >&2; ok=1; }
  # Unlisted files: everything under the directory except the MANIFEST itself. Match
  # the whole path field at end of line, so `intake/a.md` never vouches for `a.md`.
  while IFS= read -r f; do
    grep -qE "^[0-9a-f]{64}  ${f//./\\.}\$" "$m" \
      || { echo "verify: $d — $f is not pinned in $m" >&2; ok=1; }
  done < <(find "$d" -type f ! -name MANIFEST ! -name .DS_Store | sort)
  return $ok
}
intake_gate() { pinned_dir_gate intake "intake is read-only"; }

# Spec pin (D-022): the RATIFIED 1.0 spec is a protected path. Same mechanism as the
# intake pin, so "protected" is enforced, not just written in the charter. A
# deliberate spec change = the human's gate + a decision record + a re-pin of
# spec/MANIFEST in the same change.
spec_gate() { pinned_dir_gate spec "the spec is RATIFIED (D-022): a change needs the human's gate and a re-pin"; }

# The lab smoke needs Node. A missing interpreter is RED, never a skip: a
# skipped invariant suite reads green while proving nothing (CI's ubuntu
# runner ships Node, so this only bites a bare machine).
need_node() {
  command -v node >/dev/null 2>&1 && return 0
  echo "verify: lab — node not found; the lab smoke cannot run (install Node LTS)" >&2
  return 1
}

# Lab smoke (Phase A gate, ROADMAP): the listening twin's CORE run headless
# against SPEC §11 — N1, G1–G5, D1, Q1, R1, P1, T1, K1, C1 and the order-style
# table — each detector proven on its planted fault first, plus the embedded
# params/bank deep-equal to spec/. It does NOT prove the C++ (M1 does); it
# proves the lab is faithful enough to decide Q-A1–Q-A5 by playing. ~0.3 s.
lab_smoke_gate() {
  need_node || return 1
  node tools/lab_smoke.mjs >"$HARNESS_DIR/lab_smoke.out" 2>&1 && return 0
  echo "verify: lab smoke RED — full output in $HARNESS_DIR/lab_smoke.out:" >&2
  grep -E 'FAIL|Error' "$HARNESS_DIR/lab_smoke.out" | head -20 | sed 's/^/    /' >&2
  return 1
}

# The C++ core (M1a, T-003; approved by poll 2026-10-23): build and run the invariant
# suite on BOTH int128 paths plus the shipped-library smoke, and check the C++
# settings defaults against spec/params.json. Every check is proven on a planted
# fault inside the suite (ARP_PLANTS, a test-only build flag). A missing cmake or
# compiler is RED, never a skip: a skipped suite reads green while proving nothing.
# Warm runs take ~1.5 s; a cold build ~25 s.
core_gate() {
  command -v cmake >/dev/null 2>&1 || { echo "verify: core — cmake not found; the C++ suite cannot run" >&2; return 1; }
  local ok=0
  bash tools/core_test.sh >"$HARNESS_DIR/core_test.out" 2>&1 || {
    echo "verify: core suite RED — full output in $HARNESS_DIR/core_test.out:" >&2
    grep -E 'FAIL|error' "$HARNESS_DIR/core_test.out" | head -20 | sed 's/^/    /' >&2; ok=1; }
  python3 tools/core_params_check.py >"$HARNESS_DIR/core_params.out" 2>&1 || {
    echo "verify: core defaults drifted from spec/params.json:" >&2
    grep -E 'RED|FAIL' "$HARNESS_DIR/core_params.out" | head -10 | sed 's/^/    /' >&2; ok=1; }
  return $ok
}

fast() {
  # ---- Layer-0: seconds, not minutes. CI-blocking. -------------------------
  local ok=0
  kit_integrity     || ok=1  # kit-owned files must match .kit/MANIFEST
  leak_gate         || ok=1  # privacy gate: kit-core, keep it first
  private_name_gate || ok=1  # privacy gate: OURS (ADR-014 alias rule)
  structure_gate    || ok=1
  manifest_gate     || ok=1
  intake_gate       || ok=1  # intake/ is read-only: pinned bytes
  spec_gate         || ok=1  # spec/ is RATIFIED (D-022): pinned bytes
  lab_smoke_gate    || ok=1  # Phase A: the lab twin's invariants, each proven on a plant
  core_gate         || ok=1  # M1a: the C++ core's invariant suite (both int128 paths), each proven on a plant
  return $ok
}

full() {
  fast || return $?
  # ---- Layer-E: the whole gate. Run before closing a queue item. -----------
  # Nothing beyond fast yet: goldens and sweeps arrive with the C++ core (ROADMAP).
  # CPU (Release) will be reported, NEVER gated.
  return 0
}

case "$TARGET" in
  fast)   fast;  record fast  $? ;;
  full)   full;  record full  $? ;;
  report) cat "$HARNESS_DIR/last-verify.json" 2>/dev/null || { echo '{"target":null,"exit":null}'; exit 1; } ;;
  *)      echo "usage: ./verify fast|full|report" >&2; exit 64 ;;
esac
